{
  "name": "forgeflow",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "dependencies": {
    "@tingrudeng/automation-gateway-core": "workspace:*",
    "pino": "^9.6.0",
    "ws": "^8.18.3"
  },
  "scripts": {
    "docs:validate": "python3 scripts/validate_docs.py",
    "lint": "eslint \"apps/dispatcher/src/**/*.ts\" \"packages/*/src/**/*.ts\" \"scripts/**/*.ts\" \"services/*/src/**/*.ts\"",
    "lint:fix": "eslint \"apps/dispatcher/src/**/*.ts\" \"packages/*/src/**/*.ts\" \"scripts/**/*.ts\" \"services/*/src/**/*.ts\" --fix",
    "coverage:critical": "node scripts/run-critical-coverage.mjs",
    "verify:stage2": "pnpm --filter @forgeflow/dispatcher test tests/modules/server/runtime-state.test.ts tests/modules/server/dispatcher-server.test.ts tests/modules/server/review-memory.test.ts tests/modules/server/task-worktree.test.ts tests/modules/server/run-worker-daemon.test.ts tests/modules/server/trae-automation-worker.test.ts && pnpm --filter @tingrudeng/worker-review-orchestrator-cli test tests/watch.test.ts tests/inspect.test.ts && pnpm --filter console exec vitest run src/components/__tests__/MetricsGrid.test.tsx src/components/__tests__/Lists.test.tsx src/components/__tests__/TerminalPanel.test.tsx && pnpm --filter @tingrudeng/trae-beta-runtime test && pnpm typecheck",
    "verify:stage3": "pnpm --filter @forgeflow/dispatcher test tests/modules/server/runtime-state.test.ts tests/modules/server/runtime-state-sqlite.test.ts tests/modules/server/dispatcher-server.test.ts && pnpm --filter @forgeflow/dispatcher-store-core test && pnpm --filter @forgeflow/dispatcher-store-postgres test && pnpm --filter @forgeflow/dispatcher-queue-postgres test && pnpm --filter @forgeflow/provider-registry test && pnpm verify:shadow-drift && node scripts/verify-stage3-dr.mjs && pnpm typecheck",
    "verify:stage3:live": "node scripts/verify-live-dispatcher-dr.mjs",
    "verify:shadow-drift": "node scripts/check-shadow-drift.mjs .forgeflow-dispatcher",
    "verify:shadow-drift:reconcile": "node scripts/check-shadow-drift.mjs .forgeflow-dispatcher --reconcile --record-alert",
    "verify:shadow-drift:reconciler": "node scripts/run-shadow-reconciler.mjs .forgeflow-dispatcher --output .forgeflow-dispatcher/shadow-reconciler-status.json",
    "verify:shadow-cutover": "node scripts/check-shadow-drift.mjs .forgeflow-dispatcher --require-configured --require-primary-backend --max-mismatches 0 --max-delta 0",
    "verify:shadow-cutover:reconciler": "node scripts/run-shadow-reconciler.mjs .forgeflow-dispatcher --output .forgeflow-dispatcher/shadow-reconciler-status.json --require-configured --require-primary-backend --max-mismatches 0 --max-delta 0",
    "verify:shadow-cutover:drill": "node scripts/verify-shadow-cutover-drill.mjs .forgeflow-dispatcher",
    "verify:shadow-cutover:drill:evidence": "node scripts/verify-shadow-cutover-drill.mjs .forgeflow-dispatcher --output .forgeflow-dispatcher/shadow-cutover-drill.json",
    "verify:shadow-cutover:approve": "node scripts/approve-shadow-cutover.mjs .forgeflow-dispatcher --evidence .forgeflow-dispatcher/shadow-cutover-drill.json",
    "verify:shadow-cutover:approval": "node scripts/verify-shadow-cutover-approval.mjs .forgeflow-dispatcher",
    "verify:shadow-cutover:ready": "node scripts/verify-shadow-cutover-ready.mjs .forgeflow-dispatcher",
    "verify:shadow-cutover:ready:evidence": "node scripts/verify-shadow-cutover-ready.mjs .forgeflow-dispatcher --output .forgeflow-dispatcher/shadow-cutover-ready.json",
    "verify:shadow-cutover:complete": "node scripts/verify-shadow-cutover-complete.mjs .forgeflow-dispatcher",
    "verify:shadow-cutover:complete:evidence": "node scripts/verify-shadow-cutover-complete.mjs .forgeflow-dispatcher --output .forgeflow-dispatcher/shadow-cutover-complete.json",
    "verify:shadow-cutover:revoke": "node scripts/revoke-shadow-cutover.mjs .forgeflow-dispatcher --reason operator_rollback",
    "verify:runtime-packages": "node scripts/check-runtime-package-readiness.mjs",
    "verify:runtime-packages:published": "node scripts/check-runtime-package-readiness.mjs --check-registry --check-published-metadata --require-published",
    "verify:runtime-packages:install": "node scripts/verify-runtime-package-install.mjs",
    "verify:runtime-packages:published-smoke": "node scripts/verify-published-runtime-smoke.mjs --require-published",
    "report:runtime-packages:setup": "node scripts/report-runtime-package-setup.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@vitest/coverage-v8": "^3.0.7",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.15.5",
    "eslint": "^9.39.4",
    "globals": "^17.4.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.57.0",
    "vitest": "^3.0.7",
    "zod": "^3.24.2"
  }
}
