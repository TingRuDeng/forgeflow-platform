{
  "name": "@tingrudeng/gemini-beta-runtime",
  "version": "0.1.0-beta.2",
  "private": false,
  "description": "Minimal remote-machine runtime package for ForgeFlow Gemini worker daemon",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TingRuDeng/forgeflow-platform.git",
    "directory": "packages/gemini-beta-runtime"
  },
  "homepage": "https://github.com/TingRuDeng/forgeflow-platform/tree/main/packages/gemini-beta-runtime",
  "bugs": {
    "url": "https://github.com/TingRuDeng/forgeflow-platform/issues"
  },
  "type": "module",
  "bin": {
    "forgeflow-gemini-beta": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "PUBLISHING.md"
  ],
  "keywords": [
    "forgeflow",
    "worker",
    "runtime",
    "gemini"
  ],
  "scripts": {
    "build": "pnpm --filter @tingrudeng/beta-runtime-core build && tsc -p tsconfig.build.json",
    "prepublishOnly": "node ../../scripts/rewrite-workspace-deps.mjs package.json",
    "typecheck": "pnpm --filter @tingrudeng/beta-runtime-core build && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tingrudeng/beta-runtime-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
